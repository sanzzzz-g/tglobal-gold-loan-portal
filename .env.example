# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN AUTHENTICATION
# Set a strong initial password (at least 12 characters) for the first admin provisioning.
# In production, ADMIN_INITIAL_PASSWORD must be configured or the account initialized securely.
ADMIN_EMAIL="admin@tglobal.com"
ADMIN_INITIAL_PASSWORD="your-secure-admin-password-min-12-chars"
JWT_SECRET="generate-a-cryptographically-secure-random-secret-for-production"
PORT=3000
DEMO_GOLD_RATE=7000

